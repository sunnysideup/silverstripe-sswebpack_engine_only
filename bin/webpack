#!/bin/bash
set -euo pipefail
shopt -s nullglob

# ---------------------------------------------------------------------------
# webpack — one entry point for the sswebpack engine
#
# Usage:  webpack <command> [theme-dir] [options]
#
# Commands:
#   install   install engine deps + the theme's project modules
#   hot       dev build served with hot reloading (HMR) in the browser
#   watch     dev build, rebuild on change (to disk, no browser integration)
#   build     production build
#
# Options are translated into the WEBPACK_* environment variables that
# webpack.config.js reads — so you never set those by hand. See --help.
#
# Run this from the base folder of your project.
# ---------------------------------------------------------------------------

# --- use the project's node via nvm, if it's installed ---------------------
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck disable=SC1091
  source "$NVM_DIR/nvm.sh"
  nvm use node || true
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
WORKING_DIR="$(pwd)"

ENGINE_DIR="themes/sswebpack_engine_only" # holds package.json + webpack.config.js
MARKER="src/main.js"                      # identifies a buildable theme (auto-detect)

print_help() {
  cat <<EOF

 ---------------------------------
   webpack
 ---------------------------------
   Usage:
     webpack <command> [theme-dir] [options]

   Commands:
     install              engine deps + the theme's project modules
     hot                  dev build with hot reloading (HMR) in the browser
     watch                dev build, rebuild on change (to disk)
     build                production build

   Theme:
     [theme-dir]          may also be given with -t. Anywhere (themes/… or
                          vendor/…). If omitted, the first folder under
                          ./themes/ containing '$MARKER' is used.
                          A buildable theme needs:
                            src/main.js  src/style.scss  src/editor.scss

   Options:
     -t, --theme DIR      theme directory (same as the positional arg)
     -j, --js FILE        JS entry        (default src/main.js)
     -c, --css FILE       CSS entry       (default src/style.scss)
     -e, --editor FILE    editor CSS      (default src/editor.scss)
     -d, --dist DIR       output dir      (default <theme>/dist)
     -n, --node-dir DIR   node_modules    (default <theme>/my_node_modules)
         --jquery         include jQuery in the bundle
         --no-jquery      exclude jQuery              (default)
     -h, --help           show this message

   Options for 'hot' only:
         --no-hmr         full page reload instead of CSS hot-inject
         --host HOST      dev-server host             (default localhost)
         --port PORT      dev-server port             (default 8080)
         --public-path P  URL path the dist is served at

   Examples:
     webpack watch
     webpack build themes/main
     webpack build vendor/sunnysideup/cms-niceties/client --no-jquery
     webpack hot
     webpack hot themes/main --no-hmr --port 9000

   NB. Run this from the base folder of your project.

   Errors?
     consider using: nvm install --lts && nvm use --lts

 ---------------------------------

EOF
}

help_and_exit() {
  local code="${1:-0}"
  # explicit help -> stdout; usage errors -> stderr
  if ((code == 0)); then print_help; else print_help >&2; fi
  exit "$code"
}

require_value() { # $1 = flag, $2 = value (may be empty when missing)
  if [[ -z "${2:-}" ]]; then
    echo "Option '$1' requires a value." >&2
    help_and_exit 1
  fi
}

# ---------------------------------------------------------------------------
# parse args
#   first positional  = command
#   second positional = theme dir (optional; -t/--theme is an alias)
#   flags map to WEBPACK_* env vars, applied at dispatch
# ---------------------------------------------------------------------------
cmd=""
dir=""
opt_js=""
opt_css=""
opt_editor=""
opt_dist=""
opt_nodedir=""
opt_jquery="" # "", "yes" or "no"
opt_hmr=""    # "", "no"
opt_host=""
opt_port=""
opt_pubpath=""

positional() {
  if [[ -z "$cmd" ]]; then
    cmd="$1"
  elif [[ -z "$dir" ]]; then
    dir="$1"
  else
    printf 'Unexpected argument: %q\n' "$1" >&2
    help_and_exit 1
  fi
}

# normalise --key=value into "--key value" so the loop only handles the space form
if (($#)); then
  norm=()
  for a in "$@"; do
    case "$a" in
    --*=*) norm+=("${a%%=*}" "${a#*=}") ;;
    *) norm+=("$a") ;;
    esac
  done
  set -- "${norm[@]}"
fi

while (($#)); do
  case "$1" in
  -h | --help | help) help_and_exit 0 ;;
  -t | --theme) require_value "$1" "${2:-}"; dir="$2"; shift ;;
  -j | --js) require_value "$1" "${2:-}"; opt_js="$2"; shift ;;
  -c | --css) require_value "$1" "${2:-}"; opt_css="$2"; shift ;;
  -e | --editor) require_value "$1" "${2:-}"; opt_editor="$2"; shift ;;
  -d | --dist) require_value "$1" "${2:-}"; opt_dist="$2"; shift ;;
  -n | --node-dir) require_value "$1" "${2:-}"; opt_nodedir="$2"; shift ;;
  --host) require_value "$1" "${2:-}"; opt_host="$2"; shift ;;
  --port) require_value "$1" "${2:-}"; opt_port="$2"; shift ;;
  --public-path) require_value "$1" "${2:-}"; opt_pubpath="$2"; shift ;;
  --jquery) opt_jquery="yes" ;;
  --no-jquery) opt_jquery="no" ;;
  --hmr) opt_hmr="yes" ;;
  --no-hmr) opt_hmr="no" ;;
  --)
    shift
    while (($#)); do
      positional "$1"
      shift
    done
    break
    ;;
  -*)
    printf 'Unknown option: %q\n' "$1" >&2
    help_and_exit 1
    ;;
  *) positional "$1" ;;
  esac
  shift
done

[[ -z "$cmd" ]] && help_and_exit 1

case "$cmd" in
install | hot | watch | build) ;;
*)
  echo "Unknown command: $cmd" >&2
  help_and_exit 1
  ;;
esac

# ---------------------------------------------------------------------------
# auto-detect a theme when none supplied (first ./themes/* with src/main.js)
# ---------------------------------------------------------------------------
if [[ -z "$dir" ]]; then
  for candidate in themes/*/; do
    candidate="${candidate%/}"                      # strip trailing slash
    [[ "$candidate" == "$ENGINE_DIR" ]] && continue # never the engine itself
    if [[ -e "$candidate/$MARKER" ]]; then
      dir="$candidate"
      break
    fi
  done

  if [[ -z "$dir" ]]; then
    echo "No theme supplied and no folder under ./themes/ contains '$MARKER'." >&2
    echo "Pass one explicitly, e.g.  webpack $cmd themes/main" >&2
    exit 1
  fi
  echo "Auto-selected theme: $dir"
fi

dir="${dir%/}" # normalise: no trailing slash

# ---------------------------------------------------------------------------
# sanity checks
# ---------------------------------------------------------------------------
if [[ ! -d "$WORKING_DIR/$ENGINE_DIR" ]]; then
  echo "Engine not found: $WORKING_DIR/$ENGINE_DIR" >&2
  echo "Run this from the base folder of your project." >&2
  exit 1
fi
if [[ ! -d "$WORKING_DIR/$dir" ]]; then
  echo "Theme folder not found: $dir" >&2
  exit 1
fi
if [[ "$cmd" != "install" && ! -f "$WORKING_DIR/$dir/$MARKER" ]]; then
  echo "Theme '$dir' has no $MARKER — is it the right folder?" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# report
# ---------------------------------------------------------------------------
cat <<EOF

 ---------------------------------
   Running webpack $cmd
 ---------------------------------
   script dir:      $SCRIPT_DIR
   engine dir:      $WORKING_DIR/$ENGINE_DIR
   theme dir:       $dir
   project modules: ${opt_nodedir:-$dir/my_node_modules}/
   dist dir:        ${opt_dist:-$dir/dist}
 ---------------------------------

EOF

# ---------------------------------------------------------------------------
# collect flag -> WEBPACK_* overrides (only the ones actually set)
#   WEBPACK_ROOT_DIR is the absolute project base, so path resolution never
#   depends on how deep the engine sits.
# ---------------------------------------------------------------------------
envassign=("WEBPACK_ROOT_DIR=$WORKING_DIR" "WEBPACK_THEME_DIR=$dir")
[[ -n "$opt_js" ]] && envassign+=("WEBPACK_JS_FILE=$opt_js")
[[ -n "$opt_css" ]] && envassign+=("WEBPACK_CSS_FILE=$opt_css")
[[ -n "$opt_editor" ]] && envassign+=("WEBPACK_EDITOR_FILE=$opt_editor")
[[ -n "$opt_dist" ]] && envassign+=("WEBPACK_DIST_DIR=$opt_dist")
[[ -n "$opt_nodedir" ]] && envassign+=("WEBPACK_NODE_DIR=$opt_nodedir")
[[ -n "$opt_jquery" ]] && envassign+=("WEBPACK_INCLUDE_JQUERY=$opt_jquery")
[[ -n "$opt_hmr" ]] && envassign+=("WEBPACK_HMR=$opt_hmr")
[[ -n "$opt_host" ]] && envassign+=("WEBPACK_DEV_HOST=$opt_host")
[[ -n "$opt_port" ]] && envassign+=("WEBPACK_DEV_PORT=$opt_port")
[[ -n "$opt_pubpath" ]] && envassign+=("WEBPACK_PUBLIC_PATH=$opt_pubpath")

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
if [[ "$cmd" == "install" ]]; then

  update_browserslist() {
    # Skip cleanly if node tooling isn't present
    if ! command -v npx >/dev/null 2>&1; then
      echo "WARN: npx not found, skipping browserslist update." >&2
      return 0
    fi

    # timeout guards against a hung network call; || captures the failure
    if timeout 120 npx --yes update-browserslist-db@latest; then
      echo "INFO: browserslist DB updated."
    else
      local rc=$?
      echo "WARN: browserslist update failed (exit ${rc}), continuing." >&2
      return 0   # swallow the error so the script keeps going
    fi
  }

  update_browserslist
  echo "-----------------------------"
  echo "installing engine deps"
  echo "-----------------------------"
  (cd "$WORKING_DIR/$ENGINE_DIR" && npm install && npm audit fix)

  if [[ -d "$WORKING_DIR/$dir/my_node_modules" ]]; then
    echo "-----------------------------"
    echo "installing project modules in $dir/my_node_modules"
    echo "-----------------------------"
    (cd "$WORKING_DIR/$dir/my_node_modules" && npm install && npm audit fix)
  else
    echo "No $dir/my_node_modules/ folder — skipping project-module install."
  fi
else
  # map the friendly command name to the npm script name
  npm_script="$cmd"
  [[ "$cmd" == "hot" ]] && npm_script="dev-server"

  if [[ "$cmd" == "hot" ]]; then
    echo "hot reloading on http://${opt_host:-localhost}:${opt_port:-8080}   (Ctrl-C to stop)"
    [[ "$opt_hmr" == "no" ]] && echo "HMR off: full-page reload on save"
    echo "note: if your dev site is https, see the mixed-content caveat"
  fi

  echo "-----------------------------"
  echo "start $cmd"
  echo "-----------------------------"
  (cd "$WORKING_DIR/$ENGINE_DIR" && env "${envassign[@]}" npm run "$npm_script")
fi

echo " ################################################"
echo " ################################################"
echo " ################################################"
